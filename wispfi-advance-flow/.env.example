# WispFi Production Environment Variables
# Copy this to .env.production and fill in your actual values

# Site Configuration
VITE_SITE_URL=https://wispfi.com

# Lead Management
VITE_LEAD_ENDPOINT=https://YOUR_API/leads

# Security
VITE_RECAPTCHA_SITE_KEY=YOUR_RECAPTCHA_V3_SITE_KEY

# Analytics & Tracking
VITE_GTM_ID=GTM-XXXXXXX
VITE_HOTJAR_ID=XXXXXXX

# Social Proof
VITE_TRUSTPILOT_DOMAIN=www.trustpilot.com
VITE_TRUSTPILOT_BUSINESS_ID=YOUR_BUSINESS_UNIT_ID
VITE_TRUSTPILOT_ENABLED=true

# Privacy & Compliance
VITE_ONETRUST_DOMAIN_ID=YOUR-ONETRUST-DOMAIN-ID

# Booking System (Calendly)
VITE_ICON_SCRIPT_URL=https://assets.calendly.com/assets/external/widget.js
VITE_ICON_INLINE_BOOK_URL=https://calendly.com/wispfi/discovery-call-15min